\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{jadearticlelayout}[2026 Jade Article Layout]

% ------------------------------------------------
% Seitenlayout und Listen
% ------------------------------------------------

\RequirePackage[headsepline]{scrlayer-scrpage}
\RequirePackage[shortlabels]{enumitem}
\RequirePackage[onehalfspacing]{setspace}
\RequirePackage{lastpage}
\RequirePackage{tcolorbox}

\setlength{\parskip}{0.5ex plus 0.25ex minus 0.25ex}   

\setlist[enumerate]{label=\alph*)}

\newlength{\normalparindent}
\setlength{\normalparindent}{\the\parindent}

%--------------------%
% Part 
%--------------------%

\makeatletter
	\def\@part[#1]#2{%
	\thispagestyle{empty}%
	\vspace*{144pt}% vertical spacing
	\ifnum \c@secnumdepth >\m@ne
		\refstepcounter{part}%
		\addcontentsline{toc}{part}{\thepart\hspace{1em}#1 }%
	\else
		\addcontentsline{toc}{part}{#1}%
	\fi
	{%
		\centering% horizontal spacing
		\interlinepenalty \@M
		\normalfont
		\ifnum \c@secnumdepth >\m@ne
			\Large\bfseries
			\textcolor{jadegrau}{\exo{\partname\nobreakspace\thepart}}
			\par\nobreak
		\fi
		\huge\bfseries
		\textcolor{jaderot}{\exo{#2}}%
		\markboth{}{}%
		\par
	}%
	\nobreak
	\vskip 3ex
	\@afterheading
}
\makeatother

% ------------------------------------------------
% Section, Subsection und Subsubsection
% ------------------------------------------------

 \addtokomafont{section}{\exo\Large\bfseries\color{jaderot}}
 \addtokomafont{subsection}{\exo\large\bfseries\color{white}}


\setkomafont{section}{\exo\bfseries\Large\color{jaderot}}
\setkomafont{subsection}{\exo\bfseries\large\color{jadegrau}}
\setkomafont{subsubsection}{\exo\bfseries\normalsize\color{jadegrau}}

