% --------------------%
% Kopf- und Fußzeilen
% --------------------%

\clearpairofpagestyles

\automark[subsection]{section}

\ihead{}
\chead{}
\ohead{\headmark}

\ifoot{}
\cfoot{}
\ofoot{}

\lefoot*{%
    \pagemark\enskip
    \textcolor{jaderot}{\rule[-\dp\strutbox]{1pt}{\baselineskip}}
    \enskip
    \small{\fach}%
}

\rofoot*{%
    \small{\fach}\enskip
    \textcolor{jaderot}{\rule[-\dp\strutbox]{1pt}{\baselineskip}}
    \enskip
    \pagemark
}

\renewcommand*\sectionmarkformat{\exolight\sectionformat}
\renewcommand*\subsectionmarkformat{\exolight\subsectionformat}

\addtokomafont{pageheadfoot}{\exolight}
\addtokomafont{pagenumber}{\exolight}
\addtokomafont{headsepline}{\color{jaderot}}

\setlength{\headheight}{50pt}


% ----------------- %
% Pagestyle Jade HS
% ----------------- %

\defpagestyle{jadehs}{% 
	% Kopf
    (\textwidth, 0pt)% Linie über Kopfzeile
    {}% Kopfzeile für linke Seiten
    {}% Kopfzeile für rechte Seiten
    {}% Kopfzeile für einseitiges Layout
    (\textwidth, 0pt)% Linie unter Kopfzeile
}{%
	% Fuß
    % (\textwidth, 1pt)%
    {}%  Linke / ungerade Seiten
    {}%  Rechte / gerade Seiten
    {\centerline{\small{\fußzeile}}}%  einseitiges Layout
    % (\textwidth, 1pt)% 
}

% -------------------------------------- %
% Pagestyle Deckblatt für Aufgabenzettel
% -------------------------------------- %

\defpagestyle{deckblatt}{% 
	% Kopf
    (\textwidth, 0pt)% Linie über Kopfzeile
    {}% Kopfzeile für linke Seiten
    {}% Kopfzeile für rechte Seiten
    {%
        \parbox{.5\textwidth}{%
            \textbf{\textcolor{jadegrau}{\fach}}\\[.5ex] 
            \semester\\
            \dozent
        }%
        \hfill
        \parbox{.2\textwidth}{%
            \JadeLogo[height=1.75cm] 
        }%
    }% Kopfzeile für einseitiges Layout
    (\textwidth, 0pt)% Linie unter Kopfzeile
}{% Fußdefinition
    % (\textwidth, 1pt)%
    {}%  Linke / ungerade Seiten
    {}%  Rechte / gerade Seiten
    {}%  einseitiges Layout
    % (\textwidth, 1pt)% 
}

