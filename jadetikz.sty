\newcommand{\laplace}[2]{
    \begin{tikzpicture}
        \pgfmathsetmacro{\a}{#1}
        \pgfmathsetmacro{\b}{#2}
        \pgfmathsetmacro{\n}{\b -\a + 1}
        \pgfmathsetmacro{\h}{1/\n} 
        
        \def\xscale{0.5}
        \def\yscale{2}

        \pgfmathsetmacro{\xmin}{\a}
        \pgfmathsetmacro{\xmax}{\b}

        \def\ymax{0.4}
        
        \def\barwidth{0.25*\xscale}

        % Achsen: xmin xmax xscale ymin ymax yscale variablenname
        \achsen{\xmin}{\xmax}{\xscale}{0}{\ymax}{\yscale}{k}
        
        % Säulen
        \foreach \k in {\xmin, ..., \xmax} {
            \fill[jaderot] ({\k*\xscale - \barwidth/2}, 0) rectangle ({\k*\xscale + \barwidth/2}, \h*\yscale); 
        }
    
    \end{tikzpicture}
}

\newcommand{\binomial}[2]{%
    \begin{tikzpicture}
        \pgfmathsetmacro{\p}{#1}
        \pgfmathsetmacro{\n}{#2}
        \pgfmathsetmacro{\q}{1 - \p}
    
        \def\xscale{0.25}
        \def\yscale{2}

        \pgfmathsetmacro{\xmin}{0}
        \pgfmathsetmacro{\xmax}{\n}
    
        \def\ymax{0.4}

        \def\barwidth{0.25*\xscale}

        % Achsen: xmin xmax xscale ymin ymax yscale variablenname
        \achsen{\xmin}{\xmax}{\xscale}{0}{\ymax}{\yscale}{k}
    
        % Säulen
        \foreach \k in {\xmin,...,\xmax} {
              \pgfmathparse{factorial(\n)/(factorial(\k)*factorial(\n - \k))*(\p^\k)*(\q^(\n - \k))}%
              \let\h\pgfmathresult
              \fill[jaderot] ({\k*\xscale - \barwidth/2}, 0) rectangle ({\k*\xscale + \barwidth/2}, \h*\yscale);
        }
    \end{tikzpicture}%
}


\newcommand{\geometric}[2]{%
    \begin{tikzpicture}
        \pgfmathsetmacro{\p}{#1}
        \pgfmathsetmacro{\q}{1- \p}

        \def\xscale{0.25}
        \def\yscale{2}

        \pgfmathsetmacro{\xmin}{1}
        \pgfmathsetmacro{\xmax}{#2}
    
        \def\ymax{0.8}

        \def\barwidth{0.25*\xscale}

        % Achsen: xmin xmax xscale ymin ymax yscale variablenname
        \achsen{\xmin}{\xmax}{\xscale}{0}{\ymax}{\yscale}{n}
    
        % Säulen
        \foreach \n in {\xmin,...,\xmax} {
              \pgfmathparse{\p*\q^(\n-1)}%
              \let\h\pgfmathresult 
              \fill[jaderot] ({\n*\xscale - \barwidth/2}, 0) rectangle ({\n*\xscale + \barwidth/2}, \h*\yscale); 
        }
    \end{tikzpicture}%
}

\pgfmathdeclarefunction{uniform}{2}{%
  \pgfmathparse{1/(#2-#1)}%
  }%

\pgfmathdeclarefunction{exponential}{1}{%
  \pgfmathparse{#1*exp(-#1*x)}%
  }%

\pgfmathdeclarefunction{gauss}{2}{%
  \pgfmathparse{1/(#2*sqrt(2*pi))*exp(-((x-#1)^2)/(2*#2^2))}%
  }%