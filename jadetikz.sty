\newcommand{\funktion}[3][]{%
    \draw[#1,domain=#2,samples=100] plot (\x,{#3});
}
% Verwendung: \funktion[very thick,color=jaderot]{-3.5:3.5}{sin(\x r)}

\newcommand*{\rechterWinkel}[3]{% #1 = point, #2 = start angle, #3 = radius
    \draw[shift={(#2:#3)}, draw=jadegrau] (#1) arc[start angle=#2, delta angle=90, radius = #3];
    \fill[shift={(#2+45:#3/2)}, draw=jadegrau] (#1) circle[radius=2\pgflinewidth];
}

\newcommand*{\Winkel}[4]{% #1 = point, #2 = start angle, #3 = radius, #4 = degree
    \draw[shift={(#2:#3)}, draw=jadegrau] (#1) arc[start angle=#2, delta angle=#4, radius = #3];
    % \fill[shift={(#2+45:#3/2)}] (#1) circle[radius=2\pgflinewidth];
}

\newcommand*\circled[1]{\tikz[baseline=(char.base)]{
            \node[circle,ball color=jaderot, shade, color=white,inner sep=1.2pt] (char) {\footnotesize #1};}}

\newcommand*\triangled[1]{\tikz[baseline=(char.base)]{
            \node[regular polygon, regular polygon sides=3,draw,inner sep=1pt] (char) {#1};}}

\newcommand{\kasten}[2]{%
    \tikz{\fill[#1] (0,0) rectangle (#2,1em);}%
}

