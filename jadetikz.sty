\def\pgfcalendarmonthname#1{%
  \ifcase#1\or Januar\or Februar\or März\or April\or
  Mai\or Juni\or Juli\or August\or
  September\or Oktober\or November\or Dezember\fi
}

\newcommand{\roundnumtext}[1]{%
  \text{\pgfmathprintnumber[fixed,precision=1]{#1}}%
}

% ------------------------------------------------
% Diagramme und Wahrscheinlichkeitsverteilungen
% ------------------------------------------------

\newcommand{\achsen}[7]{% 
    \pgfmathsetmacro{\xmin}{#1}
    \pgfmathsetmacro{\xmax}{#2}
    \pgfmathsetmacro{\xscale}{#3}
    \pgfmathsetmacro{\ymin}{#4}
    \pgfmathsetmacro{\ymax}{#5}
    \pgfmathsetmacro{\yscale}{#6}

    % X-Achse, skaliert
    \draw[->] ({(\xmin - 1)*\xscale - 0.05}, 0) -- ({(\xmax + 1)*\xscale + 0.05}, 0) 
    node[right] {\scriptsize{$#7$}}; 
    % Y-Achse, skaliert
    \draw[->] ({(\xmin - 1)*\xscale}, -0.05) -- ({(\xmin - 1)*\xscale}, {(\ymax + 0.1)*\yscale + 0.05}) 
    node[above] {\scriptsize{$P(x=#7)$}};
    
    % Ticks auf der x-Achse
    \foreach \x in {\xmin, ..., \xmax} {
        \draw ({\x*\xscale}, -0.05) -- ({\x*\xscale}, 0.05); 
        \node[below] at ({\x*\xscale}, 0) {\scriptsize{\x}}; % x-Werte unter den Ticks
    }
    
    % Ticks auf der y-Achse
    \foreach \y in {0.2, 0.4, ..., \ymax} {
        \draw ({(\xmin - 1)*\xscale - 0.05}, {\y*\yscale}) -- ({(\xmin - 1)*\xscale + 0.05}, {\y*\yscale});
        \node[left] at ({(\xmin - 1)*\xscale}, {\y*\yscale}) {\tiny{\roundnumtext{\y}}}; % y-Werte links neben den Ticks
    }
}

