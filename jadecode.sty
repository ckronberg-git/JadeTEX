% ============================================================
% Python
% ============================================================

\lstdefinestyle{mypython}{
	language=python,
	basicstyle=\ttfamily\footnotesize,
	backgroundcolor=\color{jadegrau!10},
	% Zeichen, die zu Bezeichnern gehören dürfen
%	alsoletter={1234567890 },
	% Strings
	stringstyle=\color{jadegruen},
	% Kommentare
	upquote=true,
	commentstyle=\color{jadegrau}\slshape,
	% Variablen / Bezeichner
%	identifierstyle=\color{black},	
	% Sonderzeichen und Operatoren
%	otherkeywords={
%		\%, \}, \{, \&, \|, :, =, <, >, +, -, \*, /
%	},
	% Schlüsselwörter
	keywordstyle=\color{jaderot}\bfseries,
	% Python-Schlüsselwörter
	emph={
		and, as, assert, async, await, break, class, continue,
		def, del, elif, else, except, finally, for, from, global,
		if, import, in, is, lambda, nonlocal, not, or, pass,
		raise, return, try, while, with, yield, match, case, \_
	},
	emphstyle={\color{jaderot}\bfseries},
	% True, False, None
	emph={[2]True, False, None},
	emphstyle={[2]\color{jaderot}},
	% Häufige Funktionen
	emph={[3]
		range, object, type, isinstance, copy, deepcopy, zip,
		enumerate, reversed, list, set, len, dict, tuple,
		xrange, append, execfile, real, imag, reduce, str, repr
	},
	emphstyle={[3]\color{blue!60!black}},
	% NumPy / SciPy / Matplotlib
	emph={[4]
		ode, fsolve, sqrt, exp, sin, cos, arctan, arctan2,
		arccos, pi, array, norm, solve, dot, arange, isscalar,
		max, sum, flatten, shape, reshape, find, any, all, abs,
		plot, linspace, legend, quad, polyval, polyfit, hstack,
		concatenate, vstack, column\_stack, empty, zeros, ones,
		rand, vander, grid, pcolor, eig, eigs, eigvals, svd, qr,
		tan, det, logspace, roll, min, mean, cumsum, cumprod,
		diff, vectorize, lstsq, cla, eye, xlabel, ylabel, squeeze
	},
	emphstyle={[4]\color{jadegruen!60!black}},
	% Spezielle Methoden
	emph={[5]
		__init__, __del__, __add__, __mul__, __div__, __sub__, __call__, __getitem__, __setitem__, __eq__, __ne__, __nonzero__, __rmul__, __radd__, __repr__, __str__, __get__, __truediv__, __pow__, __name__, __future__, __all__, __iter__, __next__
	}, 
	emphstyle={[5]\color{violet}\bfseries},
	% print, input
	emph={[6]print, input},
	emphstyle={[6]\color{jadegruen}\bfseries},
	% self, cls
	emph={[7]self, cls},
	emphstyle={[7]\color{violet}},
	% Ausnahmen
	emph={[8]
		Exception, NameError, IndexError, SyntaxError, TypeError,
		ValueError, OverflowError, ZeroDivisionError,
		AssertionError, StopIteration
	},
	emphstyle={[8]\color{yellow!50!red}},
	% Dekoratoren
	emph={[9]
		@staticmethod, @classmethod, @property, @name, setter,
		@konsument
	},
	emphstyle={[9]\color{yellow!70!red}}
}
\lstnewenvironment{python}
{\lstset{style=mypython}}
{}

\lstdefinestyle{mypythoninline}{
	style=mypython,
	basicstyle=\ttfamily
}

\newcommand{\pyth}{\lstinline[style=mypythoninline]}

\newcommand{\inputpython}[3]{%
	\lstinputlisting[
	firstline=#2,
	lastline=#3,
	firstnumber=#2,
	breakindent=.5\textwidth,
	breaklines=true,
	style=mypython
	]{#1}%
}

