% ------------------------------------------------
% Jade-Schriften
% ------------------------------------------------

\usepackage{fontspec}       % benötigt xelatex

\defaultfontfeatures{Mapping=tex-text}
\defaultfontfeatures{Ligatures=TeX}

%-------------------------%
% NDS Frutiger 45 Light
%-------------------------%

\IfFontExistsTF{NDSFrutiger 45 Light}{
    % Systemfont vorhanden
    \setmainfont[
        BoldFont={NDSFrutiger 65 Bold},
        ItalicFont={NDSFrutiger 46 Light Italic},
        BoldItalicFont={NDSFrutiger 46 Light Italic},
        BoldItalicFeatures={FakeBold=4}
    ]{NDSFrutiger 45 Light}

    \setsansfont[
        BoldFont={NDSFrutiger 65 Bold},
        ItalicFont={NDSFrutiger 46 Light Italic},
        BoldItalicFont={NDSFrutiger 46 Light Italic},
        BoldItalicFeatures={FakeBold=4}
    ]{NDSFrutiger 45 Light}

}{
    % Fallback: mitgelieferte TTF-Dateien
    \setmainfont[
        Path=fonts/,
        Extension=.ttf,
		UprightFont=ndsfrutiger45light,
        BoldFont=ndsfrutiger45lightbold,
        ItalicFont=ndsfrutiger45lightitalic,
        BoldItalicFont=ndsfrutiger45lightitalic,
        BoldItalicFeatures={FakeBold=4}
    ]{ndsfrutiger45light}

    \setsansfont[
        Path=fonts/,
        Extension=.ttf,
		UprightFont=ndsfrutiger45light,
        BoldFont=ndsfrutiger45lightbold,
        ItalicFont=ndsfrutiger45lightitalic,
        BoldItalicFont=ndsfrutiger45lightitalic,
        BoldItalicFeatures={FakeBold=4}
    ]{ndsfrutiger45light}
}

%-------------------------%
% Exo 2
%-------------------------%

\IfFontExistsTF{Exo 2 Regular}{

    \newfontfamily\exo[
        BoldFont={Exo 2 Bold},
        ItalicFont={Exo 2 Italic},
        BoldItalicFont={Exo 2 Bold Italic}
    ]{Exo 2 Regular}

    \newfontfamily\exolight[
        BoldFont={Exo 2 Regular},
        ItalicFont={Exo 2 Light Italic},
        BoldItalicFont={Exo 2 Light Italic},
        BoldItalicFeatures={FakeBold=4}
    ]{Exo 2 Light}

}{
    
    \newfontfamily\exo[
        Path=fonts/,
        Extension=.ttf,
        BoldFont=Exo2-Bold,
        ItalicFont=Exo2-Italic,
        BoldItalicFont=Exo2-BoldItalic
    ]{Exo2-Regular}


    \newfontfamily\exolight[
        Path=fonts/,
        Extension=.ttf,
        BoldFont=Exo2-Regular,
        ItalicFont=Exo2-LightItalic,
        BoldItalicFont=Exo2-LightItalic,
        BoldItalicFeatures={FakeBold=4}
    ]{Exo2-Light}

}


%-------------------------%
% Handschrift
%-------------------------%

\IfFontExistsTF{Nothing You Could Do}{

    \newfontfamily\handschrift[
        BoldFont={Nothing You Could Do}
    ]{Nothing You Could Do}

}{
    
    \newfontfamily\handschrift[
        Path=fonts/,
        Extension=.ttf,
        BoldFont=nothing-you-could-do-bold
    ]{nothing-you-could-do-regular}

}


